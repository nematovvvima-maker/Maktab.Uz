# APP_URL: The URL where this application is hosted.
APP_URL="http://localhost:3000"

# Server Port (Railway automatically provides PORT)
PORT="3000"

# JWT / Token signing secret (set a strong random string in production)
AUTH_SECRET="CHANGE_ME_IN_PRODUCTION"

# Supabase PostgreSQL & API Configuration (optional for external Supabase deployment)
SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Telegram Bot API Token (obtained from @BotFather — keep secret on the server only)
TELEGRAM_BOT_TOKEN=

# Frontend API Endpoint (for Vercel / Next.js frontend pointing to Railway Nest.js backend)
NEXT_PUBLIC_API_URL="https://YOUR_RAILWAY_SERVICE.up.railway.app/api"
VITE_API_URL="/api"
